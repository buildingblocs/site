---
const { node } = Astro.props;
import SanityImage from "@/components/sanity/Image.astro";

console.log(node);
---

<a href={node.link} class="relative group">
    <div
        class="h-120 w-full mb-10 overflow-hidden rounded-3xl shadow-sm transition relative border border-white/15"
    >
        <SanityImage raw={false} asset={node.image.asset} alt={node.altText}
                     className="h-full w-full object-cover transition opacity-90 group-hover:opacity-100 group-hover:scale-105" />
        <div
            class="absolute top-0 bottom-0 left-0 right-0 bg-linear-to-b from-transparent via-transparent to-black opacity-50"
        >
        </div>
        <div class="absolute bottom-5 left-5">
            <h2>{node.name}</h2>
            <p>{node.desc}</p>
        </div>
    </div>
</a>
