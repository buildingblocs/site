---
import type { Props as $, TypedObject } from "astro-portabletext/types";
import Image from "./Image.astro";

type ImageProps = Parameters<typeof Image>[0];

export type Props = $<ImageProps & TypedObject>;

const { node /*, isInline */ } = Astro.props;
---
<Image {...node} raw={false}
       sizes="(max-width: 640px) 100vw, (max-width: 768px) 448px, (max-width: 1024px) 512px, 576px"
       widths={[360, 480, 648, 768, 960, 1152]}
       className="md:max-w-md lg:max-w-lg xl:max-w-xl rounded-xl w-full object-cover border border-slate-700 h-96"
/>
