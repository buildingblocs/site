---
const { pages, grids = 2 } = Astro.props;

type Page = {
    slug?: {
        current?: string;
    };
    name?: string;
    title?: string;
    host?: string;
    excerpts: {
        excerpt: string;
    };
    desc?: string;
    url?: string;
};
---

<div class="max-w-6xl px-5 mx-auto flex flex-col mt-10 gap-y-5">
    <section
        class=`grid-cols-1 sm:grid-cols-2 grid gap-5 ${grids == 3 && "lg:grid-cols-3"}`
    >
        {pages &&
            pages.map((page: Page) => (
                <a
                    href={
                        page.slug?.current
                            ? `${page.slug.current}`
                            : `${page.url}`
                    }
                    class="bg-slate-900 hover:bg-slate-800/60 rounded-3xl p-8 button flex flex-col gap-y-3 transition"
                >
                    <h3>{page.name || page.title}</h3>
                    <p class="text-slate-400 leading-normal">
                        {page.excerpts?.excerpt && page.excerpts.excerpt}
                        {page.desc && page.desc}
                        {page.host}
                    </p>
                </a>
            ))}
    </section>
</div>
