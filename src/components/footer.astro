---
import logo from "../img/colour_sidetext_dark.svg";
import { sanityClient } from "sanity:client";
import ImageAstroComponent from "./sanity/Image.astro";
import { Image } from "astro:assets";
import type { SiteInfo } from "@/sanity.types.ts";

type FooterData = {
    mainPages: NonNullable<SiteInfo["footer"]>["main"];
    social: NonNullable<SiteInfo["footer"]>["social"];
    events: Array<{ name?: string; slug?: { current: string } }>;
    aboutPages: Array<{ name?: string; slug?: { current: string } }>;
};

const { mainPages, social, events, aboutPages } = await sanityClient.fetch<FooterData>(`{
    "mainPages": *[_type == "siteInfo"][0].footer.main,
    "social": *[_type == "siteInfo"][0].footer.social,
    "events": *[_type == "event"]{name, slug},
    "aboutPages": *[_type == "about"]{name, slug}
}`);
---

<footer class="max-w-6xl mx-auto mb-8 px-5 mt-20">
    <hr class="border-white/30" />
    <div class="flex justify-between sm:flex-row flex-col">
        <div>
            <a href="/">
                <Image
                    src={logo}
                    alt="BuildingBloCS's logo"
                    class="h-10 w-auto mt-6 mb-4"
                />
            </a>
            <ul class="flex gap-x-4 ml-2 text-slate-200 flex-col sm:flex-row gap-y-2">
                {
                    mainPages?.map((page) => (
                        <li>
                            <a href={page.externalLink} class="hover:underline">
                                {page.title}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>

        <div class="flex gap-x-10 mr-20 px-2 sm:px-0 flex-col sm:flex-row">
            <ul class="mt-6 flex flex-col gap-2">
                <li class="font-medium text-xl">
                    <a href="/events">
                        Events
                    </a>
                </li>
                {events.filter((event) => !event.slug?.current.startsWith("/")).map((event) => (
                    <li class="flex flex-col gap-1">
                        <a href={`/events/${event.slug?.current}`} class="hover:underline text-slate-200">
                            {event.name}
                        </a>
                    </li>
                ))}
            </ul>

            <ul class="mt-6 flex flex-col gap-2">
                <li class="font-medium text-xl">
                    <a href="/about-us">
                        About Us
                    </a>
                </li>
                {aboutPages.filter((aboutPage) => !aboutPage.slug?.current.startsWith("/")).map((aboutPage) => (
                    <li class="flex flex-col gap-1">
                        <a href={`/about-us/${aboutPage.slug?.current}`} class="hover:underline text-slate-200">
                            {aboutPage.name}
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </div>

    <ul class="flex ml-2 mt-6 gap-x-6">
        {
            social?.map((page) => (
                <li>
                    <a
                        aria-label=`Our ${page.title}`
                        href={page.link}
                    >
                        {page.icon?.asset &&
                            <ImageAstroComponent raw asset={page.icon.asset} alt=`Our ${page.title}` />}
                    </a>
                </li>
            ))
        }
    </ul>
</footer>