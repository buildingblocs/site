---
import "./styles.css";
import Nav from "./components/nav/component.tsx";
import Footer from "./components/footer.astro";
import SiteBreadcrumb from "./components/breadcrumb";

import { sanityClient } from "sanity:client";
import Gradient from "@/components/gradient.astro";

const { title, showInfo, desc, breadcrumbs } = Astro.props;
const nav = await sanityClient.fetch(
    `{
  "event": *[_type == "event"]{name, excerpts, status, slug},
  "about": *[_type == "about" && name != "About Us" && slug.current != "/" && defined(slug.current)]{name, slug},
  "siteInfo": *[_type == "siteInfo"][0]{nav}
    }`,
);

const isHome = Astro.url.pathname === "/";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={desc} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title} | BuildingBloCS</title>
    </head>
    <body class:list={["bg-slate-950", !isHome && "pt-20!"]}>
        <Nav client:load data={nav} />
        {
            showInfo && (
                <div class="max-w-6xl mx-auto px-6 flex flex-col gap-y-2">
                    <SiteBreadcrumb breadcrumb={breadcrumbs} />
                    <h1>{title}</h1>
                    <p>{desc}</p>
                </div>
            )
        }
        <Gradient />
        <div class="min-h-[calc(100vh-14rem)]">
            <slot />
        </div>

        <Footer />
