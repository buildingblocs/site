---
import "./styles.css";
import Nav from "./components/nav/component.tsx";
import Footer from "./components/footer.astro";
import SiteBreadcrumb from "./components/breadcrumb";
import { ClientRouter } from "astro:transitions";
import LoadingIndicator from "astro-loading-indicator/component";

import { Font } from "astro:assets";
import { sanityClient } from "sanity:client";
import Gradient from "@/components/gradient.astro";

const { title, showInfo, desc, breadcrumbs } = Astro.props;
const nav = await sanityClient.fetch(
    `{
  "event": *[_type == "event"]{name, excerpts, status, slug},
  "about": *[_type == "about" && name != "About Us" && slug.current != "/" && defined(slug.current)]{name, slug},
  "siteInfo": *[_type == "siteInfo"][0]{nav}
    }`,
);

const isHome = Astro.url.pathname === "/";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={desc} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <Font cssVariable="--font-instrument" />
        <title>{title} | BuildingBloCS</title>
        <LoadingIndicator color="#ffffff" />
        <ClientRouter />
    </head>
    <!-- pt is marked impt else layout will shift on mobile nav opening?? -->
    <body class:list={["bg-slate-950", !isHome && "pt-24"]}>
        <Nav client:load data={nav} transition:persist />
        {showInfo && (
            <div class="max-w-6xl mx-auto px-6 flex mt-4 flex-col gap-y-2">
                <div class="flex flex-col gap-y-2 mr-25 mt-4">
                    <SiteBreadcrumb breadcrumb={breadcrumbs} />
                    <h1>{title}</h1>
                </div>
                <p>{desc}</p>
            </div>
        )}
        <Gradient />
        <div class="min-h-[calc(100vh-14rem)]">
            <slot />
        </div>

        <Footer />
    </body>
</html>
