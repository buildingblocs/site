---
import Layout from "../layout.astro";
import Embla from "../components/index/embla.astro";
import MainDirectory from "@/components/directory/main.astro";
import { PortableText } from "astro-portabletext";
import ColumnLayout from "@/components/sanity/columnLayout.astro";
import ContentImg from "@/components/sanity/contentImg.astro";
import ImageCover from "@/components/sanity/imageCover.astro";
import SanityImage from "@/components/sanity/Image.astro";
import {
    fetchRawPages,
    computePagePathsAndHierarchy,
    getBreadcrumbsForPage,
    getChildPagesForPage,
    type SanityPage,
    type PageBreadcrumb,
    type ChildPageSummary,
} from "@/lib/pages";

export async function getStaticPaths() {
    const rawPages = await fetchRawPages();

    if (!rawPages || rawPages.length === 0) {
        return [];
    }

    const { pagePaths, pageHierarchy } = computePagePathsAndHierarchy(rawPages);

    return rawPages.map((page) => {
        const fullPath = pagePaths.get(page._id) || "";
        const paramSlug = fullPath === "" ? undefined : fullPath;

        const breadcrumbs = getBreadcrumbsForPage(page, pageHierarchy, pagePaths);
        const childPages = getChildPagesForPage(page, rawPages, pagePaths);

        return {
            params: {
                slug: paramSlug,
            },
            props: {
                pageData: page,
                breadcrumbs,
                childPages,
            },
        };
    });
}

interface Props {
    pageData: SanityPage;
    breadcrumbs: PageBreadcrumb[];
    childPages: ChildPageSummary[];
}

const { pageData, breadcrumbs, childPages } = Astro.props;

const components = {
    type: {
        columnLayout: ColumnLayout,
        blockImage: ContentImg,
        imageCover: ImageCover,
    },
};

const formattedTitle = pageData.title
    ? pageData.title.replace(", ", ",<br>")
    : "";
---

<Layout title={pageData.title} desc={pageData.desc} breadcrumbs={breadcrumbs} showInfo={!pageData.useImageHero}>
    {pageData.useImageHero && pageData.imageHero && pageData.imageHero.length > 0 && (
        <Embla title={formattedTitle} desc={pageData.desc}>
            {pageData.imageHero.map((slide: any) => (
                <div class="embla__slide flex min-h-[90vh] min-w-full opacity-50">
                    <SanityImage
                        asset={slide.asset || slide}
                        alt={pageData.title}
                        raw={false}
                        sizes="100vw"
                        widths={[640, 960, 1280, 1600, 1920, 2560]}
                        className="object-cover min-h-[110vh] min-w-full"
                    />
                </div>
            ))}
        </Embla>
    )}

    {pageData.showList ? (
        <MainDirectory pages={childPages} grids={3} />
    ) : (
        pageData.content && (
            <div class="max-w-6xl px-5 mx-auto flex flex-col mt-5 gap-y-5">
                <PortableText
                    value={pageData.content}
                    components={components}
                />
            </div>
        )
    )}
</Layout>
