---
import Layout from "src/layout.astro";
import { sanityClient } from "sanity:client";
import MainDirectory from "@/components/directory/main.astro";

type EventLinksPage = {
    name: string;
    slug: { current: string };
    links?: Array<{ _key: string; title?: string; url: string }>;
};

interface Props {
    pageData: EventLinksPage;
}

export async function getStaticPaths() {
    const pages = await sanityClient.fetch<EventLinksPage[]>(
        `*[_type == 'event' && defined(slug.current)]{links, slug, name}`,
    );

    return pages.map((page) => {
        const cleanSlug = page.slug.current.replace(/^\/|\/$/g, "");

        return {
            params: {
                slug: cleanSlug,
            },
            props: {
                pageData: page,
            },
        };
    });
}

const { pageData } = Astro.props;

const hasLinks = pageData.links && pageData.links.length > 0;

const links = hasLinks
    ? pageData.links!.map((link) => {
          let host;

          try {
              host = new URL(link.url).hostname.replace(/^www\./, "");
          } catch {
              host = link.url.replace(/^\//, "");
          }

          const isExternal = /^https?:\/\//.test(link.url);

          return {
              ...link,
              host,
              isExternal,
          };
      })
    : [];

const breadcrumbs = [
    {
        link: "",
        name: "Events",
    },
    {
        link: `/events/${pageData.slug.current}`,
        name: pageData.name,
    },
    {
        link: "",
        name: "Links",
    },
];
---

<Layout
    title={`Links`}
    desc={`Common links for ${pageData.name}`}
    breadcrumbs={breadcrumbs}
    showInfo
>
    {
        hasLinks ? (
            <MainDirectory pages={links} grids={3} parent="events" />
        ) : (
            <div class="max-w-6xl px-5 mx-auto my-10 text-center text-slate-400">
                <p class="text-lg">No links for now</p>
            </div>
        )
    }
</Layout>
