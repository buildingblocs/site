---
import Layout from "src/layout.astro";
import UniversalDirections, { type Day } from "@/components/eventpage/UniversalDirections";
import { sanityClient } from "sanity:client";

type EventDirectionsPage = {
    name: string;
    slug: { current: string };
    directions?: Day[];
};

interface Props {
    pageData: EventDirectionsPage;
}

export async function getStaticPaths() {
    const pages = await sanityClient.fetch<EventDirectionsPage[]>(
        `*[_type == 'event' && defined(slug.current)]{directions, slug, name}`
    );

    return pages.map((page) => {
        const cleanSlug = page.slug.current.replace(/^\/|\/$/g, "");

        return {
            params: {
                slug: cleanSlug
            },
            props: {
                pageData: page
            }
        };
    });
}

const { pageData } = Astro.props;
const hasDirections = pageData.directions && pageData.directions.length > 0;

const breadcrumbs = [
    {
        link: "",
        name: "Events"
    },
    {
        link: `/events/${pageData.slug.current}`,
        name: pageData.name
    },
    {
        link: "",
        name: "Directions"
    }
];
---

<Layout
    title="Directions"
    desc="Select the day, your track, and the mode of transport to get step-by-step directions to the venue."
    breadcrumbs={breadcrumbs}
    showInfo
>
    <div class="max-w-4xl mx-auto sm:pt-0 pt-0 p-6 sm:p-10">
        {
            hasDirections ? (
                <UniversalDirections
                    client:load
                    data={pageData.directions!}
                />
            ) : (
                <div class="text-center text-slate-400 my-10">
                    <p class="text-lg">No directions for now</p>
                </div>
            )
        }
    </div>
</Layout>
