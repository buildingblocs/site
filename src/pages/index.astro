---
import Layout from "../layout.astro";
import Embla from "../components/index/embla.astro";

import { PortableText } from "astro-portabletext";
import { sanityClient } from "sanity:client";
import ColumnLayout from "@/components/sanity/columnLayout.astro";
import ContentImg from "@/components/sanity/contentImg.astro";
import SanityImage from "@/components/sanity/Image.astro";
import type { SanityImageSource } from "@sanity/image-url";
import type { About } from "@/sanity.types";

type HomePage = Omit<About, "name" | "desc" | "imageHero" | "content"> & {
    name: string;
    desc: string;
    imageHero: Array<{ asset: SanityImageSource }>;
    content: NonNullable<About["content"]>;
};

const content = await sanityClient.fetch<HomePage>(
    `*[slug.current == "/"][0]`
);

const components = {
    type: {
        columnLayout: ColumnLayout,
        blockImage: ContentImg
    }
};

const formattedTitle = content.name.replace(", ", ",<br>");
---

<style>
    .embla__slide {
        flex: 0 0 100%;
        display: flex;
        height: 90vh;
        opacity: 0.5;
    }
</style>

<Layout title={content.name}
        desc={content.desc}>

    <!-- Embla Carousel -->
    <Embla title={formattedTitle} desc={content.desc}>
        {
            content.imageHero.map((slide) => (
                <div class="embla__slide">
                    <SanityImage asset={slide.asset} alt="hi" raw={false}
                                 className="object-cover min-h-[110vh] min-w-full" />
                </div>
            ))
        }
    </Embla>

    <!-- Content -->
    <div class="max-w-6xl mx-auto px-6 lg:px-8 xl:px-0">
        <PortableText value={content.content} components={components} />
    </div>
</Layout>
